{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "prod",
        "EXPO_PUBLIC_CASHFREE_MODE": "local"
      }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "prod",
        "EXPO_PUBLIC_CASHFREE_MODE": "local"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "prod",
        "EXPO_PUBLIC_CASHFREE_MODE": "prod"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "vivek.pawar@policyplanner.com",
        "ascAppId": "6794244810",
        "appleTeamId": "W2JCTWQZLY"
      }
    }
  }
}
