{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "local",
        "EXPO_PUBLIC_CASHFREE_MODE": "local"
      }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "prod",
        "EXPO_PUBLIC_CASHFREE_MODE": "prod"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "prod",
        "EXPO_PUBLIC_CASHFREE_MODE": "local"
      }
    }
  }
}
